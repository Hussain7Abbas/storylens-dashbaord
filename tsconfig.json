{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "tests", "*.ts"],
	"exclude": ["node_modules", "dist"]
}
